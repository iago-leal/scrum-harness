{
  "name": "@scrum-harness/tool-scrum",
  "version": "0.1.0",
  "description": "Model-facing SCRUM tools for DeepSeek Harness over the ctx.scrum service: hierarchy CRUD, sprint lifecycle, Kanban moves and ceremonies",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@scrum-harness/domain": "^0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  }
}
