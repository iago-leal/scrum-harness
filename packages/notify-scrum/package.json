{
  "name": "@scrum-harness/notify-scrum",
  "version": "0.1.0",
  "description": "Off-screen notice for DeepSeek Harness: a macOS banner plus system sound when the agent needs the human — a pending approval, a question, or the end of a turn — fired only for the live root session",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-session": "*",
    "@deepseek-ai/dsh-session-title": "*",
    "@deepseek-ai/dsh-user-approval": "*"
  }
}
