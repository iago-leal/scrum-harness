{
  "name": "@scrum-harness/scrum-api",
  "version": "0.1.0",
  "description": "HTTP JSON API for the SCRUM web board: read/mutate routes over ctx.scrum registered on the DeepSeek Harness webserver",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@scrum-harness/domain": "^0.1.0",
    "@scrum-harness/probe": "^0.1.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-host-webserver": "*"
  }
}
