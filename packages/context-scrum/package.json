{
  "name": "@scrum-harness/context-scrum",
  "version": "0.1.0",
  "description": "Board-aware agent context for DeepSeek Harness: injects the workspace's active-sprint SCRUM snapshot (plus the live-board discipline) at the first step of each turn, only when it changed",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@scrum-harness/domain": "^0.1.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-llm": "*"
  }
}
